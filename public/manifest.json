{
  "manifest_version": 3,
  "name": "沃虎人才 · 招聘助手",
  "description": "读取当前 BOSS 候选人，预览、选择岗位并确认导入企业招聘系统。",
  "version": "0.2.1",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["https://www.zhipin.com/*"],
  "content_scripts": [{"matches":["https://www.zhipin.com/web/chat/recommend*","https://www.zhipin.com/web/frame/recommend/*","https://www.zhipin.com/web/frame/c-resume/*"],"js":["main.js"],"run_at":"document_start","all_frames":true,"world":"MAIN"}],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "沃虎人才 · 读取候选人" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: http://localhost:* http://127.0.0.1:*; base-uri 'none'; frame-ancestors 'none'"
  }
}
